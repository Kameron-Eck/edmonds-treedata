# ── ignore everything at root, then whitelist ──
/*
!/.gitignore
!/.gitattributes
!/README.md
!/pyproject.toml
!/Scripts/
!/Admin/
# Admin: only the literature tracker
/Admin/*
!/Admin/Literature_Tracker.xlsx
# Fixed 2026-08-19: the file actually lives at repo root (README.md line ~31), not
# Admin/ - the rule above matched nothing and the tracker was never version-controlled.
!/Literature_Tracker.xlsx

# ── inside Scripts: code+docs yes, artifacts no ──
Scripts/logs/
Scripts/.versions/
# Permission rules live in USER settings (P11.5), never in the repo: the whitelist above
# un-ignores all of Scripts/, so a Scripts/.claude/ written by /permissions would otherwise
# be swept into a commit.
Scripts/.claude/
__pycache__/
*.pyc
.ipynb_checkpoints/
*.bak*
# data that must never sneak in
*.tif
*.pt
*.pth
*.parquet
*.gpkg
*.npz
# Drive/Office noise
desktop.ini
~$*

# ── phase4/qc: track the FINDINGS, never the rasters ──────────────────────
# Added 2026-08-18. These are small text artefacts (~155 KB total) that ARE the
# results of the measurement work: honest scores, reference-agreement
# partitions, height curves, the mask inventory. Two reasons to version them:
#   1. sample_{year}_labels.csv holds HUMAN photo-interpretation — hours of
#      irreplaceable effort that no script can regenerate.
#   2. Everything else can be regenerated, but only from the exact code + input
#      state; having the outputs in git makes results diffable over time and
#      survives loss of the Drive mount.
# Rasters stay out: *.tif is ignored globally, and chip/subdirectory contents
# are excluded because only files at the qc/ level are whitelisted.
!/phase4/
/phase4/*
!/phase4/qc/
/phase4/qc/*
!/phase4/qc/*.png
!/phase4/qc/*.txt
!/phase4/qc/*.csv
# ledger_recovery/ (2026-09-07): the only surviving copies of six days of queue-status
# history that a ledger-routing defect erased from the lake (commit e499355). Evidence,
# not lake junk — the one subfolder the qc/ whitelist admits.
!/phase4/qc/ledger_recovery/
!/phase4/qc/*.json
# *.md added 2026-08-29: the arm PR/ROC comparison tables are findings TEXT, which
# is exactly what this block exists to keep. Their .png companions stay ignored —
# the .md carries every number, the figure is redundant weight.
!/phase4/qc/*.md
# sector_campaign harvest subdir (2026-08-26): same findings-not-rasters rule
!/phase4/qc/sector_campaign/
/phase4/qc/sector_campaign/*
!/phase4/qc/sector_campaign/*.csv
!/phase4/qc/sector_campaign/*.json
# tilesets/ (2026-09-06): one immutable CSV per tile set — row_off, col_off, split,
# block. This is WHICH TILES a run trained on, the provenance no raster carries and
# the lake cannot be trusted to preserve (a re-tile overwrites its directory in
# place). 41,856 tiles across 71 sets is under 1 MB pruned, so it is tracked text,
# not a pointer. Same findings-not-rasters rule as the block above.
!/phase4/qc/tilesets/
/phase4/qc/tilesets/*
!/phase4/qc/tilesets/*.csv
# curves/ (2026-09-06): the full precision-recall sweep behind every scored arm —
# k, thresh, tp, fn, fp, recall, precision, f1 at all 254 cuts. The CURVE is the
# primitive; every precision/recall pair anyone quotes is a projection of it, so
# with these tracked an operating-point question is answerable from a checkout
# instead of a GPU. 87 curves, 1.15 MB.
!/phase4/qc/curves/
/phase4/qc/curves/*
!/phase4/qc/curves/*.csv

# ── Reports: track the WRITING, never the source PDFs ─────────────────────
# Added 2026-08-18. Reports/ was ignored wholesale by the /* rule, which meant
# Measurement_Validity_Assessment_2026-08-18.md — the document CHATLOG STATE
# names as the live agenda, and whose U1-U8 are the open question list — was
# NOT version-controlled. Neither were the canopy brief or the report dossier.
# That contradicts the same reasoning written above for phase4/qc: these are
# hand-written analysis that no script regenerates, and they are exactly what
# should survive loss of the Drive mount.
#
# Only prose and small tables are tracked. The source PDFs stay out — the
# planning-board packet alone is 16 MB, and they are external documents that
# can be re-downloaded, not work product.
!/Reports/
/Reports/*
!/Reports/*.md
!/Reports/*.csv
# generated findings ledger — work product, small
!/Reports/*.docx

# ── .github: track the CI workflow, nothing else ──────────────────────────
# Added 2026-08-25 (overhaul E03). The /* rule at the top ignored .github/
# wholesale, so .github/workflows/ci.yml was invisible to git — `git add` on it
# is a silent no-op and CI would never fire. Whitelisted the same way phase4/qc
# and Reports/ are: the directory, then only the workflow YAML inside it.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml

# never track per-session Claude Code settings (the Scripts/ whitelist would otherwise catch them)
Scripts/.claude/
*.egg-info/

# per-crown products of the crown state model: 18 MB each, regenerated in ~100 s (docs/SCHEMAS.md)
phase4/qc/crown_state*_intervals.csv
phase4/qc/crown_state*_posterior.npz
