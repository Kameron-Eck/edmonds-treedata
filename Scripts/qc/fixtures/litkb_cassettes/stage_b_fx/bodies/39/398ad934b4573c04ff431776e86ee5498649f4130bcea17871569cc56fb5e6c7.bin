                        <title classid="main title" classname="main title" schemeid="dnet:dataCite_title"
                               schemename="dnet:dataCite_title">Learning Distributions Generated by One-Layer ReLU Networks</title> 
                        <creator>Sujay Sanghavi</creator> 
