                                         schemename="dnet:publication_resource"/> 
                           <refereed classid="0002" classname="nonPeerReviewed" schemeid="dnet:review_levels"
                                     schemename="dnet:review_levels"/> 
                           <url>http://arxiv.org/abs/1805.03498</url> 
                	          <webresource>
                	             <url>http://arxiv.org/abs/1805.03498</url>
                	          </webresource> 
                        </instance> 
