                  <title classid="main title" classname="main title" schemeid="dnet:dataCite_title"
                         schemename="dnet:dataCite_title">State-of-the-Art in Sequential Change-Point Detection</title> 
                  <title classid="subtitle" classname="subtitle" schemeid="dnet:dataCite_title"
                         schemename="dnet:dataCite_title"
                         inferred="false"
                         provenanceaction="sysimport:crosswalk:repository"
