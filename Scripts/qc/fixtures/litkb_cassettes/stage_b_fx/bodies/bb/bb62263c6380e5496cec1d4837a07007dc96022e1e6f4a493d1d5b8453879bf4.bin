                                    schemename="dnet:result_typologies"/> 
                        <collectedfrom name="Crossref" id="openaire____::081b82f96300b6a6e3d282bad31cb6e2"/> 
                        <publisher>MDPI AG</publisher> 
                        <creator>Lloyd L. Coulter</creator> 
                     </result> 
