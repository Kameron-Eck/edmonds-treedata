                             schemename="dnet:pid_types">10.1016/j.ijepes.2016.06.014</pid> 
                        <title classid="main title" classname="main title" schemeid="dnet:dataCite_title"
                               schemename="dnet:dataCite_title">Fuzzy based damping controller for TCSC using local measurements to enhance transient stability of power systems</title> 
