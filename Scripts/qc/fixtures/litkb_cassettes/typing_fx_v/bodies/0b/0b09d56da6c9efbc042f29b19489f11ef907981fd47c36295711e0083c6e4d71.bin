                  <title classid="main title" classname="main title" schemeid="dnet:dataCite_title"
                         schemename="dnet:dataCite_title">DeepForest: A Python package for RGB deep learning tree crown delineation</title> 
                  <title classid="main title" classname="main title" schemeid="dnet:dataCite_title"
                         schemename="dnet:dataCite_title">DeepForest: A                     &lt;scp&gt;Python&lt;/scp&gt;                     package for RGB deep learning tree crown delineation</title> 
                  <title classid="main title" classname="main title" schemeid="dnet:dataCite_title"
                         schemename="dnet:dataCite_title">deepforest a python package for rgb deep learning tree crown delineation</title> 
                  <title classid="main title" classname="main title" schemeid="dnet:dataCite_title"
                         schemename="dnet:dataCite_title"
                         inferred="false"
                         provenanceaction="sysimport:crosswalk:repository"
                         trust="0.9">DeepForest : A Python package for RGB deep learning tree crown delineation</title> 
                  <bestaccessright classid="OPEN" classname="Open Access" schemeid="dnet:access_modes"
                                   schemename="dnet:access_modes"/> 
                  <creator rank="1" name="Ben G." surname="Weinstein" orcid="0000-0002-2176-7935">Ben G. Weinstein</creator> 
                  <creator rank="2" name="Sergio" surname="Marconi" orcid="0000-0002-8096-754x">Sergio Marconi</creator> 
                  <creator rank="3" name="Mélaine" surname="Aubry‐Kientz"
                           orcid_pending="0000-0002-4439-8626">Mélaine Aubry‐Kientz</creator> 
