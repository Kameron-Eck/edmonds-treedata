{
 "target_file": "D:/edmonds-pipeline/backup/Full_Image/Pipeline Imagery/2020_coe_rgb.tif",
 "angle": "solar-geometry dating of the 2020 anchor, per site, plus the single-vs-multi-date question",
 "method": {
  "name": "sun (azimuth, elevation) per site by ray-casting shadows from the lidar CHM against the ortho",
  "forward_model": "ground pixel p is shadowed for sun elevation e iff the lidar HORIZON ANGLE H(p;a)=max_s atan((CHM(p+s*u_a)-CHM(p))/d_s) exceeds e, with u_a the horizontal unit vector toward the sun and d_s the GROUND distance",
  "azimuth_estimator": "argmax over azimuth of the local step amplitude in mean image brightness binned against H (7 deg windows either side)",
  "elevation_estimator": "break point of a continuous two-segment weighted least-squares line fitted to brightness vs H",
  "why_two_segments": "the first segment's gentle slope is the SKY-VIEW-FACTOR term (ground near tall objects loses diffuse light in every direction, and is measurable at the anti-sun azimuth); the break is where the DIRECT beam is cut off, i.e. the sun elevation",
  "crs_handling": "EPSG:3857 is conformal, so an azimuth measured in Web-Mercator pixel space IS the true geographic azimuth (meridians are vertical; no convergence term). Distances are multiplied by cos(47.811)=0.671646 to get GROUND metres before any height/length ratio. CHM DN x 0.2 = real vertical metres.",
  "working_grid": "0.5 Web-Mercator m (=0.336 ground m); site box 500 WM m = 336 x 336 ground m; CHM padded 120 WM m; rays traced to 78 ground m",
  "receiver_mask": "CHM < 3.0 m (raised from 1.5 m because the 2020 sun is high and its short shadows land inside the CHM's smeared object footprint)",
  "null_control": "azimuths where the sun can NEVER exceed 30 deg at 47.811 N (272..87 deg through north) are scored with the same statistic; amp_ratio_anti = amplitude at the fitted azimuth divided by the amplitude at its opposite",
  "quality_gate": {
   "amp_min": 12.0,
   "amp_ratio_anti_min": 2.5,
   "derived_from": "the 2012 control: the only outright azimuth failure, N_B7, had amp_ratio_anti 1.21, the lowest in the set"
  }
 },
